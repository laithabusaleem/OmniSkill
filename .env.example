# Optional GitHub API token for higher rate limits on add/sync/doctor --online.
# Create a classic or fine-grained token with public_repo (or Contents: Read) as needed.
# Never commit a real token.
# GITHUB_TOKEN=

# Optional public repository URL used in generated attribution footers.
# Only set when the URL is real; OmniSkill never invents one.
# OMNISKILL_REPO_URL=https://github.com/OWNER/REPO
